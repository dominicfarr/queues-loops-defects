Icon?

# Editors and agents (Claude Code keeps its agent worktrees in .claude/)
.claude/
.vscode/
.idea/
*.swp
*~

# Secrets: never commit. Env files, certificates, private keys (e.g. Apple .p8)
.env
.env.*
!.env.example
*.pem
*.key
*.p8

# Logs
*.log
npm-debug.log*

# Python (uv: uv.lock IS committed)
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# JS/TS and Svelte (package-lock.json IS committed)
node_modules/
dist/
dist-ssr/
.svelte-kit/
.vite/
*.local
*.tsbuildinfo
coverage/
.vitest/
.eslintcache
.prettiercache
.stylelintcache

# Docker (local overrides; env files are covered under Secrets)
docker-compose.override.yml
compose.override.yaml

# AWS (CloudFormation and SAM build output)
.aws-sam/
packaged*.yaml
samconfig.local.toml

